# Local Python files
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local data only; do not commit raw feeds or warehouse state
/data/*
!/data/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.csv.gz

# JS output / IDE
node_modules/
apps/web/dist/
.vscode/
.idea/

# dbt local build output
/dbt/target/
/dbt/logs/
/dbt/dbt_packages/

# Secrets
.env
.env.*
!.env.example
/dbt/.user.yml

# Local browser demo exports, never commit unreviewed dataset bundles
/apps/web/public/demo/

# Generated Playwright results and HTML report
/apps/web/test-results/
/apps/web/playwright-report/
/apps/web/test-results-v2/
/apps/web/playwright-report-v2/

# Portfolio screenshot runner's Playwright scratch output
/apps/web/test-results-portfolio/
