{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchline.local/contracts/m05_kev_epss_cohort_bands.v2.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "metric_id",
      "band_order",
      "cohort_category",
      "band_label",
      "kev_snapshot_id",
      "epss_snapshot_id",
      "kev_catalog_date_released",
      "epss_source_date",
      "kev_retrieved_at_utc",
      "epss_retrieved_at_utc",
      "epss_model_version",
      "kev_cve_count",
      "denominator_all_kev",
